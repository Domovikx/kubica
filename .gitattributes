# ============================================================
# .gitattributes — политика контента репозитория
# (по образцу The Survival of Sarah Rose)
# 1) Нормализация текста: LF везде
# 2) Бинарники: без диффов и конвертации переводов строк
# ============================================================

* text=auto
*.py   text eol=lf
*.scad text eol=lf
*.ts   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.glb  binary
*.stl  binary
*.step binary
*.fcstd binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.zip  binary
*.exe  binary
*.dll  binary
*.woff binary
*.woff2 binary