{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "blender": {
      "type": "local",
      "command": ["uvx", "ageless-blender-mcp"],
      "enabled": true,
      "environment": {
        "MCP_ADAPTER": "socket",
        "MCP_SOCKET_HOST": "127.0.0.1",
        "MCP_SOCKET_PORT": "9876",
        "MCP_ENABLE_SCRIPT_EXECUTE": "1"
      }
    }
  }
}
